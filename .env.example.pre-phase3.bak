APP_NAME="Sales Report Dashboard INGCO & SMI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/sales-report-web/public
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv_ingco

DB_HOST_INGCO=10.9.2.18
DB_PORT_INGCO=1433
DB_DATABASE_INGCO=AS_INGCO
DB_USERNAME_INGCO=your_username
DB_PASSWORD_INGCO=your_password
DB_ENCRYPT_INGCO=no
DB_TRUST_SERVER_CERTIFICATE_INGCO=true

DB_HOST_SMI=10.9.2.18
DB_PORT_SMI=1433
DB_DATABASE_SMI=AS_SMI
DB_USERNAME_SMI=your_username
DB_PASSWORD_SMI=your_password
DB_ENCRYPT_SMI=no
DB_TRUST_SERVER_CERTIFICATE_SMI=true

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=strict

# Local SQLite storage for combined KPI targets
TARGET_DB_DATABASE=database/database.sqlite

# Dashboard administrator bootstrap account
# Run: php artisan dashboard-security:install
DASHBOARD_ADMIN_NAME="Dashboard Administrator"
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD="change-this-password"

# Dashboard security
DASHBOARD_SECURITY_CONNECTION=sqlite_targets
DASHBOARD_PASSWORD_MIN_LENGTH=8
DASHBOARD_SESSION_IDLE_MINUTES=30
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_IP_MAX_ATTEMPTS=15
DASHBOARD_LOGIN_DECAY_SECONDS=60
DASHBOARD_DEVICE_COOKIE=dashboard_device_token
DASHBOARD_DEVICE_COOKIE_MINUTES=525600
# Set true on HTTPS production
DASHBOARD_DEVICE_COOKIE_SECURE=false
DASHBOARD_DEVICE_COOKIE_SAME_SITE=strict
