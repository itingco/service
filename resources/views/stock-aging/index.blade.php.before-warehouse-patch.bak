@push('scripts')
<script>
(function () {

    // Client-side sorting: no extra SQL queries when a column header is clicked.
    document.querySelectorAll('table[data-sortable-stock]').forEach(function (table) {
        const tbody = table.tBodies[0];
        if (!tbody) return;
        const headers = Array.from(table.tHead?.rows[0]?.cells || []);
        const parseNumber = function (text) {
            const value = String(text || '').replace(/[^0-9,.-]/g, '').trim();
            if (!value || value === '—') return null;
            // UI formats numeric data in Indonesian locale (e.g. 1.234,50).
            const num = Number(value.replace(/\./g, '').replace(',', '.'));
            return Number.isFinite(num) ? num : null;
        };
        headers.forEach(function (header, index) {
            const type = header.dataset.sortType;
            if (!type) return;
            header.tabIndex = 0;
            header.setAttribute('role', 'button');
            header.setAttribute('aria-label', 'Urutkan berdasarkan ' + header.textContent.trim());
            const sort = function () {
                const direction = header.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
                const multiplier = direction === 'ascending' ? 1 : -1;
                headers.forEach(function (h) { h.removeAttribute('aria-sort'); });
                header.setAttribute('aria-sort', direction);
                const rows = Array.from(tbody.rows).filter(function (r) { return r.cells.length === headers.length; });
                rows.sort(function (a, b) {
                    const aText = a.cells[index].textContent.trim();
                    const bText = b.cells[index].textContent.trim();
                    if (type === 'number') {
                        const av = parseNumber(aText);
                        const bv = parseNumber(bText);
                        if (av === null && bv === null) return 0;
                        if (av === null) return 1;
                        if (bv === null) return -1;
                        return multiplier * (av - bv);
                    }
                    return multiplier * aText.localeCompare(bText, 'id', {numeric:true, sensitivity:'base'});
                });
                rows.forEach(function (row) { tbody.appendChild(row); });
            };
            header.addEventListener('click', sort);
            header.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); sort(); }
            });
        });
    });

    // Merge the two legacy sidebar entries on this consolidated page.
    const strategyLink = document.querySelector('.app-sidebar a[href="{{ route('stock-aging.strategy-review') }}"]');
    strategyLink?.remove();
    const stockLink = document.querySelector('.app-sidebar a[href="{{ route('stock-aging.index') }}"]');
    if (stockLink) {
        stockLink.title = 'Stock & Aging Review';
        const label = stockLink.querySelector('.nav-label');
        if (label) label.textContent = 'Stock & Aging Review';
    }

    const list = document.getElementById('groupChipList');
    const hidden = document.getElementById('groupHiddenInputs');
    const select = document.getElementById('groupFieldSelect');
    const add = document.getElementById('addGroupBtn');
    if (!list || !hidden || !select || !add) return;

    const labels = @json($groupFieldOptions);

    function syncInputs() {
        const emptyLabel = document.getElementById('groupEmptyLabel');
        if (emptyLabel) emptyLabel.hidden = list.querySelectorAll('.group-chip').length > 0;
        hidden.innerHTML = '';
        list.querySelectorAll('.group-chip').forEach(function (chip) {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'group_by[]';
            input.value = chip.dataset.field || '';
            hidden.appendChild(input);
        });
    }

    function bindChip(chip) {
        chip.querySelector('.remove-group')?.addEventListener('click', function () {
            chip.remove();
            syncInputs();
        });
        chip.addEventListener('dragstart', function () { chip.classList.add('dragging'); });
        chip.addEventListener('dragend', function () { chip.classList.remove('dragging'); syncInputs(); });
    }

    list.querySelectorAll('.group-chip').forEach(bindChip);

    list.addEventListener('dragover', function (event) {
        event.preventDefault();
        const dragging = list.querySelector('.dragging');
        if (!dragging) return;
        const siblings = [...list.querySelectorAll('.group-chip:not(.dragging)')];
        const next = siblings.find(function (item) {
            const box = item.getBoundingClientRect();
            return event.clientX < box.left + box.width / 2 && event.clientY <= box.bottom;
        });
        if (next) list.insertBefore(dragging, next); else list.appendChild(dragging);
    });

    add.addEventListener('click', function () {
        const field = select.value;
        if (!field || list.querySelector('[data-field="'+field+'"]')) return;
        const chip = document.createElement('div');
        chip.className = 'group-chip';
        chip.draggable = true;
        chip.dataset.field = field;
        chip.innerHTML = '<i class="bi bi-grip-vertical text-secondary"></i><span></span><button type="button" class="remove-group" title="Hapus group">×</button>';
        chip.querySelector('span').textContent = labels[field] || field;
        list.appendChild(chip);
        bindChip(chip);
        syncInputs();
    });

    syncInputs();
})();
</script>
@endpush
