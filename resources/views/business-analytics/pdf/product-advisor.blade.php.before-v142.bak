<div class="page-break"></div><div class="section">Strategy Action Lab</div>@foreach($strategies as $s)<div class="box"><b>{{ $s['title']??'Strategy' }}</b> <span class="tag">{{ $s['priority']??'-' }}</span> <span class="tag">{{ $s['channel']??'-' }}</span><div><b>Hypothesis:</b> {{ $s['hypothesis']??'-' }}</div><div><b>Audience:</b> {{ $s['target_audience']??'-' }}</div><div><b>Offer/Action:</b> {{ $s['offer']??'-' }}</div><div><b>Duration:</b> {{ $s['duration_days']??'-' }} hari | <b>KPI:</b> {{ implode(', ',$s['kpis']??[]) }}</div><div><b>Stop rule:</b> {{ $s['stop_rule']??'-' }}</div></div>@endforeach
