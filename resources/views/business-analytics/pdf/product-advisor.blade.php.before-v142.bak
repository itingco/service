<!doctype html><html><head><meta charset="utf-8"><style>
@page{margin:18px 22px}body{font-family:DejaVu Sans,sans-serif;font-size:8.5px;color:#1f2937}.title{font-size:18px;font-weight:700;color:#17365d}.sub{color:#667085}.section{font-size:11px;font-weight:700;margin:11px 0 5px;color:#17365d}.table{width:100%;border-collapse:collapse}.table th{background:#17365d;color:#fff;padding:4px;text-align:left}.table td{border-bottom:1px solid #e5e7eb;padding:4px;vertical-align:top}.grid{width:100%;border-collapse:separate;border-spacing:5px}.kpi,.box{border:1px solid #d0d5dd;padding:7px}.kpi b{display:block;font-size:11px}.right{text-align:right}.tag{font-size:7px;border:1px solid #d0d5dd;padding:2px 4px}.muted{color:#667085}.page-break{page-break-before:always}.small{font-size:7.5px}
